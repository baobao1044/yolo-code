# Sample configuration for yolo-code
# Copy this file to .env and fill in real values
# (yolo-code auto-loads .env from the current directory on startup; any
#  variable already set in your shell or via a CLI flag takes precedence.)

# ── LLM Provider ──────────────────────────────────────────────
# API key (required). YOLO_API_KEY is canonical; OPENAI_API_KEY is read as a
# fallback only if YOLO_API_KEY is unset.
YOLO_API_KEY=sk-...
# (fallback) OPENAI_API_KEY=sk-...

# Base URL of the OpenAI-compatible API
# Default: https://api.openai.com/v1
YOLO_BASE_URL=https://api.openai.com/v1

# Model name (default: gpt-4o)
YOLO_MODEL=gpt-4o

# ── Logging ──────────────────────────────────────────────────
# Append every event to a durable, fsynced log, keeping a run replayable after
# a crash. Also available as --event-log <path>. Leave empty to disable.
YOLO_EVENT_LOG=

# Structured slog file path. NOT read by the current code — setting it produces
# no file and no error. Use YOLO_EVENT_LOG above instead.
YOLO_LOG=

# ── Auto-approve (headless mode) ─────────────────────────────
# When true, medium-risk tools (e.g. bash) run without approval
# YOLO_AUTO_APPROVE_MEDIUM=true

# When true, high-risk tools (e.g. edit_file) run without approval
# YOLO_AUTO_APPROVE_HIGH=true

# ── Sandbox ──────────────────────────────────────────────────
# Repo root (default = current directory)
# YOLO_REPO_ROOT=.

# ── TUI appearance ──────────────────────────────────────────
# Color theme: dark (default) / light / contrast / mono
# YOLO_THEME=dark

# Any non-empty value forces the mono theme (per https://no-color.org/)
# NO_COLOR=1

# Any non-empty value disables spinner animation + cursor blink (reduced motion)
# YOLO_NO_MOTION=1

# ── Provider presets ────────────────────────────────────────
# Choose a provider by name: openai, anthropic, together, groq, mistral,
# deepseek, openrouter, ollama, lmstudio, fireworks, perplexity, reka,
# ai21, cohere, nvidia, cloudflare, aimlapi, huggingface, siliconflow,
# novita, sambanova, lepton, volcano, qwen, zhipu, yi, moonshot, minimax,
# wandb. Ollama/LM Studio need no API key (local server). Others use their
# own env var (e.g. GROQ_API_KEY, WANDB_API_KEY) or fall back to YOLO_API_KEY.
# YOLO_PROVIDER=openai
